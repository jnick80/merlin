{
  "name": "merlin-business-os",
  "version": "0.1.0",
  "description": "Merlin Business Operating System - Enterprise entity management platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "lint:types": "tsc --noEmit",
    "validate": "npm run lint && npm run lint:types && npm run format:check && npm run test:ci && npm run build",
    "format": "prettier --write \"src/**/*.ts\" \".github/workflows/**/*.{yml,yaml}\" \"*.md\" \"*.json\" \".*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \".github/workflows/**/*.{yml,yaml}\" \"*.md\" \"*.json\" \".*.json\"",
    "db:migrate": "ts-node src/database/migrations/runner.ts",
    "db:seed": "ts-node src/database/seed.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "business",
    "entity",
    "management",
    "operating-system",
    "enterprise"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "joi": "^17.10.0",
    "pg": "^8.10.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.5.0",
    "@types/pg": "^8.20.3",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "@typescript-eslint/parser": "^6.3.0",
    "eslint": "^8.47.0",
    "jest": "^29.6.3",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
