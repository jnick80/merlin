# App/runtime settings
APP_NAME=merlin-business-os
NODE_ENV=development
PORT=3000
API_VERSION=v1
API_BASE_URL=http://localhost:3000/api
CORS_ORIGIN=http://localhost:3000
PLATFORM_EXECUTOR=local-simulated

# Logging/output
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_TO_FILES=true
LOG_DIR=logs

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=merlin_db
DB_USER=merlin_user
DB_PASSWORD=secure_password

# Security
JWT_SECRET=change-me-in-production
